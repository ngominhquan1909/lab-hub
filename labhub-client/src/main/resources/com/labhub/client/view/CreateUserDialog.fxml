<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.labhub.client.controller.CreateUserDialogController"
      style="-fx-padding:24; -fx-background-color:#F5F4EF;" spacing="14" prefWidth="420">

    <Label text="Create User Account" styleClass="section-title"/>

    <Label fx:id="errorLabel" styleClass="error-label" managed="false" visible="false"/>

    <VBox spacing="4">
        <Label text="Username *" styleClass="field-label"/>
        <TextField fx:id="usernameField" promptText="e.g. jane.doe" styleClass="text-field"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Full Name *" styleClass="field-label"/>
        <TextField fx:id="fullNameField" styleClass="text-field"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Email *" styleClass="field-label"/>
        <TextField fx:id="emailField" promptText="e.g. jane.doe@university.edu" styleClass="text-field"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Phone Number" styleClass="field-label"/>
        <TextField fx:id="phoneField" styleClass="text-field"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Initial Password *" styleClass="field-label"/>
        <PasswordField fx:id="passwordField" promptText="At least 8 characters" styleClass="password-field"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Roles" styleClass="field-label"/>
        <HBox spacing="14">
            <CheckBox fx:id="adminCheck"      text="Admin"/>
            <CheckBox fx:id="labManagerCheck" text="Lab Manager"/>
            <CheckBox fx:id="lecturerCheck"   text="Lecturer"/>
            <CheckBox fx:id="studentCheck"    text="Student" selected="true"/>
        </HBox>
    </VBox>

    <HBox fx:id="loadingBox" alignment="CENTER_LEFT" spacing="8" managed="false" visible="false">
        <ProgressIndicator prefWidth="16" prefHeight="16"/>
        <Label text="Creating…" style="-fx-text-fill:#657078;"/>
    </HBox>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Cancel" styleClass="btn-secondary" onAction="#onCancel"/>
        <Button fx:id="saveBtn" text="Create Account" styleClass="btn-primary" onAction="#onSave"/>
    </HBox>
</VBox>
