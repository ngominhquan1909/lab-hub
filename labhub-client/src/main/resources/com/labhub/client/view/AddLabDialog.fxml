<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.labhub.client.controller.AddLabDialogController"
      style="-fx-padding:24; -fx-background-color:#F5F4EF;" spacing="14" prefWidth="420">

    <Label text="Add Laboratory" styleClass="section-title"/>

    <Label fx:id="errorLabel" styleClass="error-label" managed="false" visible="false"/>

    <VBox spacing="4">
        <Label text="Lab Code *" styleClass="field-label"/>
        <TextField fx:id="labCodeField" promptText="e.g. LAB-A101" styleClass="text-field"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Name *" styleClass="field-label"/>
        <TextField fx:id="nameField" promptText="e.g. Networking Lab" styleClass="text-field"/>
    </VBox>

    <HBox spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Building" styleClass="field-label"/>
            <TextField fx:id="buildingField" promptText="e.g. Building C" styleClass="text-field"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Floor" styleClass="field-label"/>
            <TextField fx:id="floorField" promptText="e.g. 3" prefWidth="80" styleClass="text-field"/>
        </VBox>
    </HBox>

    <HBox spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Capacity" styleClass="field-label"/>
            <TextField fx:id="capacityField" promptText="e.g. 40" styleClass="text-field"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Room Type" styleClass="field-label"/>
            <TextField fx:id="roomTypeField" promptText="e.g. Computer Lab" styleClass="text-field"/>
        </VBox>
    </HBox>

    <VBox spacing="4">
        <Label text="Description" styleClass="field-label"/>
        <TextArea fx:id="descriptionField" prefRowCount="3" wrapText="true" styleClass="text-area"/>
    </VBox>

    <HBox fx:id="loadingBox" alignment="CENTER_LEFT" spacing="8" managed="false" visible="false">
        <ProgressIndicator prefWidth="16" prefHeight="16"/>
        <Label text="Saving…" style="-fx-text-fill:#657078;"/>
    </HBox>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Cancel" styleClass="btn-secondary" onAction="#onCancel"/>
        <Button fx:id="saveBtn" text="Create Lab" styleClass="btn-primary" onAction="#onSave"/>
    </HBox>
</VBox>
