<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.labhub.client.controller.EquipmentDetailDialogController"
      style="-fx-padding:24; -fx-background-color:#F5F4EF;" spacing="12" prefWidth="560" prefHeight="560">

    <Label fx:id="titleLabel" text="Equipment Detail" styleClass="section-title"/>

    <GridPane hgap="10" vgap="6">
        <columnConstraints>
            <ColumnConstraints minWidth="110"/>
            <ColumnConstraints hgrow="ALWAYS"/>
            <ColumnConstraints minWidth="90"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Asset Code" styleClass="detail-field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="assetCodeLabel" styleClass="detail-field-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Status" styleClass="detail-field-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <Label fx:id="statusLabel" styleClass="detail-field-value" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

        <Label text="Name" styleClass="detail-field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="nameLabel" styleClass="detail-field-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Condition" styleClass="detail-field-label" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <Label fx:id="conditionLabel" styleClass="detail-field-value" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

        <Label text="Category" styleClass="detail-field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="categoryLabel" styleClass="detail-field-value" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Lab" styleClass="detail-field-label" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
        <Label fx:id="labLabel" styleClass="detail-field-value" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

        <Label text="Manufacturer" styleClass="detail-field-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Label fx:id="manufacturerLabel" styleClass="detail-field-value" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label text="Model" styleClass="detail-field-label" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
        <Label fx:id="modelLabel" styleClass="detail-field-value" GridPane.rowIndex="3" GridPane.columnIndex="3"/>

        <Label text="Serial No." styleClass="detail-field-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <Label fx:id="serialLabel" styleClass="detail-field-value" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <VBox spacing="4">
        <Label text="Notes" styleClass="field-label"/>
        <Label fx:id="notesLabel" wrapText="true" styleClass="detail-field-value"/>
    </VBox>

    <Separator/>

    <Label text="History" styleClass="field-label"/>
    <HBox fx:id="historyLoadingBox" alignment="CENTER_LEFT" spacing="8" managed="false" visible="false">
        <ProgressIndicator prefWidth="16" prefHeight="16"/>
        <Label text="Loading history…" style="-fx-text-fill:#657078;"/>
    </HBox>
    <ListView fx:id="historyList" VBox.vgrow="ALWAYS" prefHeight="220"/>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Close" styleClass="btn-secondary" onAction="#onClose"/>
    </HBox>
</VBox>
