<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.labhub.client.controller.EquipmentController"
      style="-fx-padding:24; -fx-background-color:#F5F4EF;" spacing="16">

    <!-- ── Toolbar ── -->
    <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="searchField" promptText="Search equipment…"
                   styleClass="search-field" onAction="#onSearch"/>
        <ComboBox fx:id="statusFilter" promptText="All Statuses"
                  styleClass="combo-box" prefWidth="140" onAction="#onSearch"/>
        <ComboBox fx:id="labFilter" promptText="All Labs"
                  styleClass="combo-box" prefWidth="160" onAction="#onSearch"/>
        <Button text="Search" styleClass="btn-secondary" onAction="#onSearch"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addButton" text="+ Add Equipment"
                styleClass="btn-primary" onAction="#onAdd"/>
    </HBox>

    <!-- ── Loading ── -->
    <HBox fx:id="loadingBox" alignment="CENTER_LEFT" spacing="8"
          managed="false" visible="false">
        <ProgressIndicator prefWidth="16" prefHeight="16"/>
        <Label text="Loading…" style="-fx-text-fill:#657078; -fx-font-size:12px;"/>
    </HBox>

    <!-- ── Table ── -->
    <TableView fx:id="equipmentTable" VBox.vgrow="ALWAYS"
               styleClass="table-view"
               onMouseClicked="#onRowSelected">
        <columns>
            <TableColumn fx:id="colAssetCode" text="ASSET CODE" prefWidth="120"/>
            <TableColumn fx:id="colName"      text="NAME"       prefWidth="220"/>
            <TableColumn fx:id="colCategory"  text="CATEGORY"   prefWidth="130"/>
            <TableColumn fx:id="colLab"       text="LAB"        prefWidth="140"/>
            <TableColumn fx:id="colCondition" text="CONDITION"  prefWidth="100"/>
            <TableColumn fx:id="colStatus"    text="STATUS"     prefWidth="110"/>
            <TableColumn fx:id="colActions"   text=""           prefWidth="80"/>
        </columns>
        <placeholder>
            <VBox styleClass="empty-state-box" alignment="CENTER">
                <Label text="No equipment found" styleClass="empty-state-title"/>
                <Label text="Try adjusting your search or filters."
                       styleClass="empty-state-subtitle"/>
            </VBox>
        </placeholder>
    </TableView>

    <!-- ── Pagination ── -->
    <HBox alignment="CENTER_RIGHT" spacing="12">
        <Label fx:id="pageInfoLabel" text="" style="-fx-text-fill:#657078; -fx-font-size:12px;"/>
        <Button fx:id="prevPageBtn" text="← Previous" styleClass="btn-secondary"
                onAction="#onPrevPage"/>
        <Button fx:id="nextPageBtn" text="Next →" styleClass="btn-secondary"
                onAction="#onNextPage"/>
    </HBox>
</VBox>
