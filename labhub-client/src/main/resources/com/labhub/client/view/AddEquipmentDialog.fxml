<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.labhub.client.controller.AddEquipmentDialogController"
      style="-fx-padding:24; -fx-background-color:#F5F4EF;" spacing="14" prefWidth="460">

    <Label text="Add Equipment" styleClass="section-title"/>

    <Label fx:id="errorLabel" styleClass="error-label" managed="false" visible="false"/>

    <HBox spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Asset Code *" styleClass="field-label"/>
            <TextField fx:id="assetCodeField" promptText="e.g. EQ-0042" styleClass="text-field"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Name *" styleClass="field-label"/>
            <TextField fx:id="nameField" promptText="e.g. Digital Oscilloscope" styleClass="text-field"/>
        </VBox>
    </HBox>

    <HBox spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Category" styleClass="field-label"/>
            <ComboBox fx:id="categoryCombo" maxWidth="Infinity" styleClass="combo-box"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Assigned Lab" styleClass="field-label"/>
            <ComboBox fx:id="labCombo" maxWidth="Infinity" styleClass="combo-box"/>
        </VBox>
    </HBox>

    <HBox spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Manufacturer" styleClass="field-label"/>
            <TextField fx:id="manufacturerField" styleClass="text-field"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Model" styleClass="field-label"/>
            <TextField fx:id="modelField" styleClass="text-field"/>
        </VBox>
    </HBox>

    <HBox spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Serial Number" styleClass="field-label"/>
            <TextField fx:id="serialNumberField" styleClass="text-field"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Condition" styleClass="field-label"/>
            <ComboBox fx:id="conditionCombo" maxWidth="Infinity" styleClass="combo-box"/>
        </VBox>
    </HBox>

    <VBox spacing="4">
        <Label text="Notes" styleClass="field-label"/>
        <TextArea fx:id="notesField" prefRowCount="3" wrapText="true" styleClass="text-area"/>
    </VBox>

    <HBox fx:id="loadingBox" alignment="CENTER_LEFT" spacing="8" managed="false" visible="false">
        <ProgressIndicator prefWidth="16" prefHeight="16"/>
        <Label text="Saving…" style="-fx-text-fill:#657078;"/>
    </HBox>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Cancel" styleClass="btn-secondary" onAction="#onCancel"/>
        <Button fx:id="saveBtn" text="Create Equipment" styleClass="btn-primary" onAction="#onSave"/>
    </HBox>
</VBox>
