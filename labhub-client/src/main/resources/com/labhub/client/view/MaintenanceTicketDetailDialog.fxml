<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.labhub.client.controller.MaintenanceTicketDetailDialogController"
      style="-fx-padding:24; -fx-background-color:#F5F4EF;" spacing="12" prefWidth="460">

    <Label fx:id="titleLabel" text="Maintenance Ticket" styleClass="section-title"/>
    <Label fx:id="errorLabel" styleClass="error-label" managed="false" visible="false"/>

    <GridPane hgap="10" vgap="6">
        <columnConstraints>
            <ColumnConstraints minWidth="110"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Equipment" styleClass="detail-field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="equipmentLabel" styleClass="detail-field-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Reporter" styleClass="detail-field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="reporterLabel" styleClass="detail-field-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Priority" styleClass="detail-field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="priorityLabel" styleClass="detail-field-value" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Status" styleClass="detail-field-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Label fx:id="statusLabel" styleClass="detail-field-value" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label text="Assignee" styleClass="detail-field-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <Label fx:id="assigneeLabel" styleClass="detail-field-value" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        <Label text="Opened" styleClass="detail-field-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <Label fx:id="openedLabel" styleClass="detail-field-value" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>

    <VBox spacing="4">
        <Label text="Description" styleClass="field-label"/>
        <Label fx:id="descriptionLabel" wrapText="true" styleClass="detail-field-value"/>
    </VBox>

    <!-- Manager actions: assign -->
    <VBox fx:id="assignBox" spacing="6">
        <Separator/>
        <Label text="Assign To" styleClass="field-label"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <ComboBox fx:id="assigneeCombo" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="combo-box"/>
            <Button text="Assign" styleClass="btn-secondary" onAction="#onAssign"/>
        </HBox>
    </VBox>

    <!-- Manager actions: resolve -->
    <VBox fx:id="resolveBox" spacing="6">
        <Separator/>
        <Label text="Resolution Notes *" styleClass="field-label"/>
        <TextArea fx:id="resolutionNotesField" prefRowCount="3" wrapText="true" styleClass="text-area"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Repair Cost" styleClass="field-label"/>
            <TextField fx:id="repairCostField" promptText="e.g. 45.00" prefWidth="120" styleClass="text-field"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Mark Resolved" styleClass="btn-success" onAction="#onResolve"/>
        </HBox>
    </VBox>

    <!-- Manager actions: close -->
    <HBox fx:id="closeBox" spacing="10" alignment="CENTER_RIGHT">
        <Separator HBox.hgrow="ALWAYS"/>
        <Button text="Close Ticket" styleClass="btn-primary" onAction="#onClose"/>
    </HBox>

    <HBox fx:id="loadingBox" alignment="CENTER_LEFT" spacing="8" managed="false" visible="false">
        <ProgressIndicator prefWidth="16" prefHeight="16"/>
        <Label text="Working…" style="-fx-text-fill:#657078;"/>
    </HBox>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="doneBtn" text="Done" styleClass="btn-secondary" onAction="#onDone"/>
    </HBox>
</VBox>
