<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.labhub.client.controller.NewBorrowDialogController"
      style="-fx-padding:24; -fx-background-color:#F5F4EF;" spacing="14" prefWidth="460">

    <Label text="New Borrow Request" styleClass="section-title"/>

    <Label fx:id="errorLabel" styleClass="error-label" managed="false" visible="false"/>

    <VBox spacing="4" VBox.vgrow="ALWAYS">
        <Label text="Available Equipment * (select one or more)" styleClass="field-label"/>
        <ListView fx:id="equipmentList" prefHeight="200"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Purpose *" styleClass="field-label"/>
        <TextArea fx:id="purposeField" prefRowCount="2" wrapText="true" styleClass="text-area"/>
    </VBox>

    <HBox spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Expected Return Date *" styleClass="field-label"/>
            <DatePicker fx:id="returnDatePicker" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Time (HH:mm)" styleClass="field-label"/>
            <TextField fx:id="returnTimeField" promptText="17:00" prefWidth="100" styleClass="text-field"/>
        </VBox>
    </HBox>

    <HBox fx:id="loadingBox" alignment="CENTER_LEFT" spacing="8" managed="false" visible="false">
        <ProgressIndicator prefWidth="16" prefHeight="16"/>
        <Label text="Submitting…" style="-fx-text-fill:#657078;"/>
    </HBox>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Cancel" styleClass="btn-secondary" onAction="#onCancel"/>
        <Button fx:id="saveBtn" text="Submit Request" styleClass="btn-primary" onAction="#onSave"/>
    </HBox>
</VBox>
