<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.labhub.client.controller.NewMaintenanceTicketDialogController"
      style="-fx-padding:24; -fx-background-color:#F5F4EF;" spacing="14" prefWidth="440">

    <Label text="File Maintenance Ticket" styleClass="section-title"/>

    <Label fx:id="errorLabel" styleClass="error-label" managed="false" visible="false"/>

    <VBox spacing="4">
        <Label text="Equipment *" styleClass="field-label"/>
        <ComboBox fx:id="equipmentCombo" maxWidth="Infinity" styleClass="combo-box"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Priority" styleClass="field-label"/>
        <ComboBox fx:id="priorityCombo" maxWidth="Infinity" styleClass="combo-box"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Description of Issue *" styleClass="field-label"/>
        <TextArea fx:id="descriptionField" prefRowCount="4" wrapText="true" styleClass="text-area"/>
    </VBox>

    <HBox fx:id="loadingBox" alignment="CENTER_LEFT" spacing="8" managed="false" visible="false">
        <ProgressIndicator prefWidth="16" prefHeight="16"/>
        <Label text="Submitting…" style="-fx-text-fill:#657078;"/>
    </HBox>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Cancel" styleClass="btn-secondary" onAction="#onCancel"/>
        <Button fx:id="saveBtn" text="File Ticket" styleClass="btn-primary" onAction="#onSave"/>
    </HBox>
</VBox>
