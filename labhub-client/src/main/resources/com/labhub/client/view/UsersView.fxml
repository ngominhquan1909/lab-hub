<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.labhub.client.controller.UsersController"
      style="-fx-padding:24; -fx-background-color:#F5F4EF;" spacing="16">

    <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="searchField" promptText="Search users…"
                   styleClass="search-field" onAction="#onSearch"/>
        <Button text="Search" styleClass="btn-secondary" onAction="#onSearch"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Create User" styleClass="btn-primary" onAction="#onCreateUser"/>
    </HBox>

    <HBox fx:id="loadingBox" alignment="CENTER_LEFT" spacing="8" managed="false" visible="false">
        <ProgressIndicator prefWidth="16" prefHeight="16"/>
        <Label text="Loading…" style="-fx-text-fill:#657078;"/>
    </HBox>

    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="colUsername" text="USERNAME"  prefWidth="140"/>
            <TableColumn fx:id="colName"     text="FULL NAME" prefWidth="200"/>
            <TableColumn fx:id="colEmail"    text="EMAIL"     prefWidth="220"/>
            <TableColumn fx:id="colRoles"    text="ROLES"     prefWidth="160"/>
            <TableColumn fx:id="colStatus"   text="STATUS"    prefWidth="90"/>
            <TableColumn fx:id="colLastLogin" text="LAST LOGIN" prefWidth="150"/>
            <TableColumn fx:id="colActions"  text="ACTIONS"   prefWidth="120"/>
        </columns>
        <placeholder>
            <VBox styleClass="empty-state-box" alignment="CENTER">
                <Label text="No users found" styleClass="empty-state-title"/>
            </VBox>
        </placeholder>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="12">
        <Label fx:id="pageInfoLabel" text="" style="-fx-text-fill:#657078; -fx-font-size:12px;"/>
        <Button fx:id="prevBtn" text="← Previous" styleClass="btn-secondary" onAction="#onPrevPage"/>
        <Button fx:id="nextBtn" text="Next →" styleClass="btn-secondary" onAction="#onNextPage"/>
    </HBox>
</VBox>
